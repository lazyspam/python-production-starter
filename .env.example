# Copy to .env and replace every replace-with-* value.
# Field names match src/app/configs/settings.py (pydantic-settings, case-insensitive).
# In ENVIRONMENT=production the JWT secrets are rejected if they contain
# replace-with, changeme, example or password.

# APPLICATION
APP_NAME=python-production-starter
# development | production | test
# Swagger UI and the OpenAPI JSON are served only when ENVIRONMENT is not production.
ENVIRONMENT=development
PORT=3000
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# LOGGING AND OBSERVABILITY (OpenTelemetry, external OTLP HTTP collector)
# - LOG_LEVEL: debug | info | warning | error | critical
# - OTEL_EXPORTER_OTLP_ENDPOINT: collector base URL. Blank = telemetry off.
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=

# DATABASE (Postgres; the app rewrites postgresql:// to postgresql+asyncpg://)
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
DATABASE_POOL_SIZE=10

# REDIS (required: cache, rate limits, login lockouts, and BullMQ queues)
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=python-production-starter:

# AUTH: JWT
# Secrets must be at least 32 characters. Generate with: openssl rand -hex 32
# Use two different values for access and refresh.
JWT_ACCESS_SECRET=replace-with-a-64-char-access-secret-from-openssl-rand-hex-32
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_SECRET=replace-with-a-64-char-refresh-secret-from-openssl-rand-hex-32
JWT_REFRESH_TTL_SECONDS=2592000

# AUTH: cookies (web clients receive the same tokens as HTTP-only cookies)
# AUTH_COOKIE_DOMAIN: scope cookies across subdomains, e.g. .example.com (blank = host-only)
# AUTH_COOKIE_SAME_SITE: lax | strict | none. Use none only when the web app is on a different site than the API.
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SAME_SITE=lax

# AUTH: encryption key for TOTP secrets at rest (Fernet key, must be valid)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTH_ENCRYPTION_KEY=replace-with-a-fernet-key-generated-with-cryptography

# TOTP (authenticator apps)
TOTP_ISSUER=PythonProductionStarter
TOTP_WINDOW=1

# MAIL: SMTP (Gmail shown; use an App Password, not your account password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-gmail@gmail.com
MAIL_PASS=replace-with-16-char-app-password
MAIL_FROM="App <your-gmail@gmail.com>"

# SMS: Twilio (optional; leave blank to disable SMS OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# STORAGE: S3 (or S3-compatible: MinIO / LocalStack)
# Files are never streamed through the API. Clients receive a presigned URL and
# upload or download directly against the bucket.
# - S3_ENDPOINT: blank for AWS S3. For local MinIO use http://localhost:9000 and S3_FORCE_PATH_STYLE=true.
# - S3_PUBLIC_BASE_URL: CDN or public base URL for public objects (optional).
S3_REGION=us-east-1
S3_BUCKET=app-uploads
S3_ACCESS_KEY_ID=replace-with-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-secret-access-key
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=
S3_UPLOAD_URL_TTL_SECONDS=900
S3_DOWNLOAD_URL_TTL_SECONDS=900
S3_MAX_UPLOAD_BYTES=10485760

# OAUTH: server-side ID-token verification only.
# Clients obtain an ID token from Google or Apple and send it to the API, which verifies
# signature and audience. Comma-separated list of accepted client IDs (audiences).
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
